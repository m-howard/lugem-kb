# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies. No leading slash: this is a workspace monorepo, so node_modules exists at the
# root *and* inside apps/* and infra/*. A root-anchored pattern would leave those untracked but
# not ignored, which is one `git add -A` away from committing them.
node_modules/
.pnp
.pnp.*

# Testing
coverage/
coverage-e2e/
test-results/
playwright-report/
/output/

/data

# Build output
build/
/bin
dist/
.docusaurus/
.tsbuild/

# Pulumi — stack config carries account-specific VPC and subnet IDs; only the example is tracked.
infra/*/Pulumi.*.yaml
!infra/*/Pulumi.yaml
!infra/*/Pulumi.*.yaml.example

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
.eslintcache

# Env files (can opt-in for committing if needed)
.env*
!.env.example
