node_modules
out
build
dist
.docusaurus
# ...but `scripts/build/` holds the tooling that *produces* build output. The site stage copies it
# and runs it as `@lugem/docs`' prebuild hook, so an image built without it has no `/admin` bundle
# and the stage exits non-zero. Docker's patterns are anchored at the context root, so `build`
# above does not reach this path today; the negation is here so it still cannot, whatever that
# pattern becomes. The same note is in .gitignore, .prettierignore and eslint.config.mjs.
!scripts/build

# Local databases and runtime data (never bake into an image).
data
*.db
*.db-shm
*.db-wal
sqlite.db*

# Secrets and local env.
.env
.env.*
!.env.example

# Infra/IaC and CI (not needed in the app image).
infra
# ...except this one manifest. The image runs `bun install --frozen-lockfile` from the repo root,
# and bun.lock describes infra/pulumi as a workspace. Without its package.json the install resolves
# a different tree than the lockfile pins, and a frozen install refuses rather than drifting.
!infra/pulumi/package.json
.github

# VCS, editor, OS, logs.
.git
.gitignore
.vscode
.idea
.devcontainer
*.log
npm-debug.log*

# Test output.
coverage
test-results
playwright-report
.DS_Store

# NOTE: repo-root `docs/` is deliberately NOT ignored. It is the Docusaurus content root
# (apps/docs/docusaurus.config.ts sets docs.path to it), so the image build needs it.
