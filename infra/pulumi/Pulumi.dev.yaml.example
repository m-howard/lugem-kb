# Copy to Pulumi.dev.yaml and fill in your own values, or set each key with `pulumi config set`.
# Real stack files are gitignored — they carry account-specific VPC and subnet IDs.
#
# Prerequisites this stack does NOT create for you:
#   1. Bedrock model access for the embedding model, granted in aws:region.
#   2. Bedrock model access for the answer model, granted separately in the same region.
#   3. A region where S3 Vectors is available (see S3_VECTORS_REGIONS in src/config.ts).
# All are checked or documented in docs/deploying-to-aws.md.

config:
  aws:region: us-east-1

  # The existing VPC to deploy into. Nothing in this stack creates one.
  lugem-kb:vpcId: vpc-0123456789abcdef0

  # Private subnets for the Fargate tasks. Must belong to vpcId, and must have a route to
  # S3, Bedrock and ECR (a NAT gateway, or VPC endpoints for each).
  lugem-kb:privateSubnetIds:
    - subnet-0aaaaaaaaaaaaaaa1
    - subnet-0aaaaaaaaaaaaaaa2

  # Subnets for the load balancer. Must belong to vpcId. Public subnets if albScheme is
  # internet-facing; private subnets are correct for an internal load balancer.
  lugem-kb:publicSubnetIds:
    - subnet-0bbbbbbbbbbbbbbb1
    - subnet-0bbbbbbbbbbbbbbb2

  # internal (default) or internet-facing.
  lugem-kb:albScheme: internal

  # Required. The Bedrock model that writes answers for POST /v1/ask. There is no default: a model
  # ID names a billed resource your account must have been granted access to, and the task role is
  # scoped to exactly this one. Verify the ID against the target region before setting it:
  #   aws bedrock list-foundation-models --region <aws:region>
  #   aws bedrock list-inference-profiles --region <aws:region>
  lugem-kb:answerModelId: anthropic.replace-me-v1:0

  # Only needed when answerModelId is a cross-region inference profile (a us. / eu. / apac. prefix).
  # Bedrock authorises against the profile ARN *and* the underlying foundation model in every
  # region the profile can route to, so each of those regions must be listed here. Granting the
  # profile alone yields an AccessDenied naming the profile, which is a misleading place to start.
  # lugem-kb:answerModelRegions:
  #   - us-east-1
  #   - us-west-2

  # Optional. With a certificate the listener is HTTPS and HTTP redirects to it; without one the
  # listener is plain HTTP. Set this for anything beyond a demo.
  # lugem-kb:certificateArn: arn:aws:acm:us-east-1:111122223333:certificate/...

  # Optional overrides — defaults shown.
  # lugem-kb:desiredCount: "1"
  # lugem-kb:cpu: "512"
  # lugem-kb:memory: "1024"
  # lugem-kb:logRetentionDays: "30"
  # lugem-kb:containerPort: "3000"
  # lugem-kb:corpusPrefix: docs/
  # lugem-kb:embeddingModelId: amazon.titan-embed-text-v2:0
  # lugem-kb:answerMaxTokens: "700"
  # lugem-kb:askRateLimitPerMinute: "20"

  # The relevance score a passage must clear to be cited — and, below it, the point at which the
  # answer model is not called at all. Raise it to make the assistant decline more readily; lower
  # it to make it answer from weaker matches. Exposed here because it is the gate, not a detail.
  # lugem-kb:retrievalScoreThreshold: "0.4"

  # Set true only if AWS has added S3 Vectors to a region newer than src/config.ts knows about.
  # lugem-kb:allowUnverifiedRegion: "true"

  # --- The repository backing the knowledge base ---------------------------------------------
  # All optional. corpusRepository is the master switch: leave it unset and this stack manages no
  # GitHub resources at all. Setting it needs a GitHub admin token in GITHUB_TOKEN or github:token.
  # Full guide: docs/corpus-repository.md.

  # owner/name of the repository holding the markdown corpus.
  # lugem-kb:corpusRepository: m-howard/lugem-kb

  # Set this when adopting an existing repository — GitHub clears a description the repository
  # resource does not declare.
  # lugem-kb:corpusRepositoryDescription: Documentation that publishes itself and answers questions.

  # Default main. A branch name, not a fully qualified ref.
  # lugem-kb:corpusDefaultBranch: main

  # Create a new private repository, or adopt an existing one. Mutually exclusive. Adoption is a
  # one-time step: set corpusRepositoryImportId, run `pulumi up`, then remove the key.
  # lugem-kb:corpusRepositoryCreate: "true"
  # lugem-kb:corpusRepositoryImportId: lugem-kb

  # Checks that must pass before merge. Defaults to the five that run on every pull request. The
  # Infrastructure workflow's checks are paths-filtered, so requiring them strands unrelated PRs.
  # lugem-kb:requiredStatusChecks:
  #   - Lint
  #   - Typecheck
  #   - Test
  #   - Build
  #   - Playwright

  # Reuse an account-level GitHub identity provider rather than creating one. An account holds at
  # most one per URL, so set this if anything else in the account already uses GitHub OIDC.
  # lugem-kb:githubOidcProviderArn: arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com

  # The GitHub App the gateway authenticates as (requirements.md R2). Both numeric ids, or neither.
  # Pulumi cannot create the app; it creates the secret its private key goes in, and you write the
  # PEM out of band with `aws secretsmanager put-secret-value`.
  # lugem-kb:cmsGitHubAppId: "123456"
  # lugem-kb:cmsGitHubAppInstallationId: "78901234"
