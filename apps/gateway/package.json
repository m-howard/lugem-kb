{
  "name": "@lugem/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Bun + Hono service that serves the documentation site and a read-only API over the knowledge base.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "3.1106.0",
    "@aws-sdk/client-bedrock-runtime": "3.1106.0",
    "@aws-sdk/client-s3": "3.1106.0",
    "hono": "4.13.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  }
}
