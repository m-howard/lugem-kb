{
  "name": "Lugem KB",
  "build": {
    "dockerfile": "Dockerfile",
    // The repo root, not `.devcontainer/`. The image reads `.nvmrc`, `.bun-version` and
    // `infra/pulumi/package.json` at build time so its toolchain cannot drift from the repo.
    "context": ".."
  },
  // The webpack client compile in `docs:build` sizes its default V8 heap off total container
  // memory, which collides with the IDE/tsserver/extension-host baseline already resident here
  // and gets OOM-killed rather than erroring cleanly. Cap it to leave that headroom.
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=1536"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        // Matches .editorconfig and .prettierrc. Anything else means the editor and the formatter
        // disagree on every save.
        "editor.tabSize": 2,
        // The repo pins TypeScript ~6.0.3, ahead of the version VS Code bundles.
        "typescript.tsdk": "node_modules/typescript/lib",
        "explorer.sortOrder": "type"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "vscode-icons-team.vscode-icons",
        "mikestead.dotenv",
        "DavidAnson.vscode-markdownlint",
        "dbaeumer.vscode-eslint",
        "github.vscode-github-actions",
        "GitHub.copilot-chat",
        "openai.chatgpt",
        "Anthropic.claude-code",
        "EditorConfig.EditorConfig",
        "oven.bun-vscode",
        "ms-playwright.playwright",
        "pulumi.pulumi"
      ],
      "mcp": {
        "servers": {
          "playwright": {
            "command": "npx",
            "args": ["-y", "@playwright/mcp@latest"]
          },
          "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp"]
          },
          "devTools": {
            "command": "npx",
            "args": ["-y", "chrome-devtools-mcp@latest"]
          }
        }
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true,
      "installSsl": true,
      // The base image already ships this user. Naming anything else creates a second, unused
      // account and leaves `remoteUser` pointing at the one without the shell setup.
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:3": {
      "moby": true,
      "azureDnsAutoDetection": true,
      "installDockerBuildx": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  }
}
